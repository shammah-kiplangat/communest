# Local development needs NO env file — the app falls back to /api, which the
# Vite dev server proxies to the backend on localhost:3000.
#
# Copy this to .env.local only to point dev at a different backend, e.g.:
# VITE_API_URL=https://communest-backend.vercel.app/api
#
# The deployed default lives in .env.production (committed). Anything set in the
# Vercel dashboard overrides it.
