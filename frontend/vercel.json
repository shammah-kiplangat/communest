{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_API_URL": "https://communest-backend.vercel.app/api"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
