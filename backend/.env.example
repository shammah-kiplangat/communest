# Copy to backend/.env and fill in from the Supabase dashboard
# (Project Settings -> API). Note the host is *.supabase.co, not .com.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Extra CORS origins, comma-separated. https://communest.vercel.app and
# http://localhost:8443 are always allowed (see lib/auth.ts).
CLIENT_URL=http://localhost:8443

# Port the local dev server listens on (the Vite proxy expects 3000)
PORT=3000

# Not read by the app — kept for running migrations / psql by hand
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
